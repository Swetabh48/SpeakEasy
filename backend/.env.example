DATABASE_URL=sqlite:///./speakeasy_board.db
# DATABASE_URL=postgresql+psycopg://speakeasy:speakeasy@127.0.0.1:5432/speakeasy

# Free hosted OpenAI-compatible (tried before Ollama), e.g. Groq:
# EVALUATOR_URL=https://api.groq.com/openai
# EVALUATOR_MODEL=llama-3.1-8b-instant
# EVALUATOR_API_KEY=gsk_...
EVALUATOR_URL=
EVALUATOR_MODEL=llama-3.1-8b-instant
EVALUATOR_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=speakeasy-board
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROMPT_VERSION=board-v6
# Full board orchestrator (analyze → memory → persona → generator)
BOARD_FAST_MODE=false
OLLAMA_TIMEOUT_SECONDS=90

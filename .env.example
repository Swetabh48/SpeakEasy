# Speakeasy — local / Vercel secrets (do not commit real keys)

# ── Board brain (works for every visitor via Vercel env — not their laptop) ─
# YOUR trained model ASKS (Modal / EVALUATOR). Gemini only SUPPORTS (analyze + polish drafts).
# Get Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# Questioner — YOUR Modal-hosted board brain (mock_interview LoRA):
#   EVALUATOR_URL=https://YOURUSER--speakeasy-board-brain-serve.modal.run
#   EVALUATOR_MODEL=speakeasy-board
EVALUATOR_URL=
EVALUATOR_MODEL=speakeasy-board
EVALUATOR_API_KEY=
# Groq fallback if Modal cold:
# EVALUATOR_URL=https://api.groq.com/openai
# EVALUATOR_MODEL=llama-3.1-8b-instant
# EVALUATOR_API_KEY=gsk_...

# Option A2 — YOUR fine-tuned model on Hugging Face (free Inference router)
# After Colab notebook training/Speakeasy_Board_LoRA_Colab.ipynb:
#   HF_TOKEN=hf_...
#   HF_BOARD_MODEL=youruser/speakeasy-board
HF_TOKEN=
HF_BOARD_MODEL=

# Option B — Ollama on this PC only (ignored on Vercel)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=speakeasy-board

# Even with no API key: board uses mock_interview style corpus (not empty hardcode)

# Option C — cloud Whisper when browser STT fails
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=
# WHISPER_MODEL=whisper-1

# Board API:
# Leave EMPTY on Vercel → uses Next.js /api/board (any PC).
# Set ONLY for local FastAPI + Ollama orchestrator:
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Public site origin for Google / magic-link redirects (REQUIRED in production)
# Must match Supabase → Authentication → URL Configuration → Site URL
NEXT_PUBLIC_SITE_URL=https://spkeasy.in

# Supabase Auth + Postgres (optional — guest mode works without these)
# Create a free project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only; leave blank unless you need admin ops
# SUPABASE_SERVICE_ROLE_KEY=

# Observability (optional — no-ops until set)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

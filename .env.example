# Speakeasy — local secrets (do not commit real keys)

# Option A — your trained / hosted OpenAI-compatible examiner API
# e.g. vLLM, TGI, HF Inference Endpoint, or a fine-tuned SpeechLLM/essay scorer wrapper
EVALUATOR_URL=
EVALUATOR_MODEL=speakeasy-examiner
EVALUATOR_API_KEY=

# Option B — Ollama on this PC (works with small models if RAM is limited, e.g. qwen2.5:1.5b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Option C — cloud Whisper for phones/iPads when browser STT fails (OpenAI-compatible)
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=
# WHISPER_MODEL=whisper-1

# Always available: local grader + browser Whisper + type-what-you-said fallback

# Speakeasy — local secrets (do not commit real keys)

# Option A — your trained / hosted OpenAI-compatible examiner API
# e.g. vLLM, TGI, HF Inference Endpoint, or a fine-tuned SpeechLLM/essay scorer wrapper
EVALUATOR_URL=
EVALUATOR_MODEL=speakeasy-examiner

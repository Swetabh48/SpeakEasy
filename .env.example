# Speakeasy — local / Vercel secrets (do not commit real keys)

# Option A — hosted OpenAI-compatible examiner / board LLM (works on Vercel)
EVALUATOR_URL=
EVALUATOR_MODEL=speakeasy-examiner
EVALUATOR_API_KEY=

# Option B — Ollama on this PC only (ignored on Vercel)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest

# Option C — cloud Whisper when browser STT fails
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=
# WHISPER_MODEL=whisper-1

# Board API:
# Leave EMPTY on Vercel → uses Next.js /api/board (any PC).
# Set ONLY for local FastAPI + Ollama orchestrator:
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Observability (optional — no-ops until set)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
